# Resend API Key - Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email address to send from (must be verified in Resend dashboard)
# For testing, use: onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Salon email to receive contact form and booking notifications
SALON_EMAIL=info@gentlecutx.com

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
